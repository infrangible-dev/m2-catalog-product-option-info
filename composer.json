{
    "name": "infrangible/m2-catalog-product-option-info",
    "description": "Shows an info box with headline, text and image when shoppers hover over a custom option or one of its values on the product page.",
    "type": "magento2-module",
    "version": "1.6.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Content",
        "tooltip for custom options",
        "info box for option values",
        "option hover information"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-info",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-option-wrapper": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionInfo\\": "src"
        }
    }
}
